{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FatiaLucro - manifestos e tabelas documentais v1",
  "description": "Descritor estrutural. O validador TypeScript tambem verifica periodos, sobreposicoes, fontes, limites, hashes, identidades e regressao.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/table"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "releaseSequence",
        "publishedAt",
        "review",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "releaseSequence": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reference"
          ],
          "properties": {
            "status": {
              "const": "reviewed"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "revision",
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "path": {
                "type": "string",
                "pattern": "^catalogs/shopee-br/[a-z0-9-]+\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 524288
              }
            }
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "adapter",
        "id",
        "marketplace",
        "version",
        "revision",
        "effectiveFrom",
        "effectiveUntil",
        "confirmation",
        "observedAt",
        "lastVerified",
        "review",
        "supersedes",
        "sources",
        "bands",
        "cnpjLow",
        "cpf",
        "programs",
        "boundaryReview"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "adapter": {
          "const": "shopee-v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "marketplace": {
          "const": "shopee-br"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "effectiveFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effectiveUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "confirmation": {
          "enum": [
            "documentary",
            "confirmed",
            "withdrawn"
          ]
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "lastVerified": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reference"
          ],
          "properties": {
            "status": {
              "const": "reviewed"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "htmlSha256",
              "checkedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://seller\\.shopee\\.com\\.br/edu/article/\\d+(/[^?#]*)?$"
              },
              "htmlSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checkedAt": {
                "type": "string",
                "minLength": 1,
                "format": "date"
              }
            }
          },
          "minItems": 5,
          "maxItems": 20
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "includeFrom",
              "to",
              "includeTo",
              "percent",
              "fixed"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^\\d{1,18}(\\.\\d{1,12})?$"
              },
              "includeFrom": {
                "type": "boolean"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,18}(\\.\\d{1,12})?$"
              },
              "includeTo": {
                "type": "boolean"
              },
              "percent": {
                "type": "string",
                "pattern": "^\\d{1,18}(\\.\\d{1,12})?$"
              },
              "fixed": {
                "type": "string",
                "pattern": "^\\d{1,18}(\\.\\d{1,12})?$"
              }
            }
          },
          "minItems": 1,
          "maxItems": 20
        },
        "cnpjLow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "below",
            "fixedPercent"
          ],
          "properties": {
            "below": {
              "type": "string",
              "minLength": 1
            },
            "fixedPercent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cpf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regressiveBelow",
            "volumeThreshold",
            "extra",
            "fixedConflict",
            "thresholdInclusive"
          ],
          "properties": {
            "regressiveBelow": {
              "type": "string",
              "minLength": 1
            },
            "volumeThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "extra": {
              "type": "string",
              "minLength": 1
            },
            "fixedConflict": {
              "type": "boolean"
            },
            "thresholdInclusive": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "programs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "returnsPerOrder",
            "highlightPercent"
          ],
          "properties": {
            "returnsPerOrder": {
              "type": "string",
              "minLength": 1
            },
            "highlightPercent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "boundaryReview": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "price",
              "status",
              "sourceIds",
              "note"
            ],
            "properties": {
              "price": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "confirmed",
                  "unresolved"
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "effectiveFrom": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    }
  }
}
